# Build output
build/
cmake-build-*/
out/

# CMake
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json

# Object/binary artifacts
*.o
*.obj
*.a
*.so
*.exe

# Python bytecode cache (experiments/, src/order_book/tools/)
__pycache__/
*.pyc

# Editor/IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.vs/
.ccls-cache/
.cache/

# OS cruft
.DS_Store
Thumbs.db

# Local secrets/config (API keys etc. — never commit these)
*.env
secrets.*

# Captured market data journals (real exchange data, written by
# kraken_feed_handler into ./journal by default — never commit these)
journal/
*.journal

# Local runtime state (the Kraken nonce high-water mark, written into ./state
# by default) — per-machine, per-API-key, never committed
state/
*.state
